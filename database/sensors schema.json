{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "_id",
    "created_at",
    "hardware_id",
    "status",
    "updated_at"
  ],
  "properties": {
    "_id": {
      "$ref": "#/$defs/ObjectId"
    },
    "area_id": {
      "$ref": "#/$defs/ObjectId"
    },
    "brand": {
      "type": "string"
    },
    "created_at": {
      "$ref": "#/$defs/Date"
    },
    "hardware_id": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "active"]
    },
    "type": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "updated_at": {
      "$ref": "#/$defs/Date"
    },
    "zone_id": {
      "$ref": "#/$defs/ObjectId"
    }
  },
  "if": {
    "properties": {
      "status": {
        "const": "active"
      }
    }
  },
  "then": {
    "required": [
      "area_id",
      "zone_id"
    ]
  },
  "$defs": {
    "ObjectId": {
      "type": "object",
      "properties": {
        "$oid": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{24}$"
        }
      },
      "required": [
        "$oid"
      ],
      "additionalProperties": false
    },
    "Date": {
      "type": "object",
      "properties": {
        "$date": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "$date"
      ],
      "additionalProperties": false
    }
  }
}