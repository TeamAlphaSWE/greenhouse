{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "_id",
    "areas",
    "created_at",
    "description",
    "name",
    "status",
    "updated_at"
  ],
  "properties": {
    "_id": {
      "$ref": "#/$defs/ObjectId"
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "target_conditions"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/ObjectId"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "target_conditions": {
            "type": "object",
            "required": [
              "humidity",
              "temperature"
            ],
            "properties": {
              "humidity": {
                "type": "object",
                "required": [
                  "max",
                  "min"
                ],
                "properties": {
                  "max": {
                    "type": "integer"
                  },
                  "min": {
                    "type": "integer"
                  }
                }
              },
              "temperature": {
                "type": "object",
                "required": [
                  "max",
                  "min"
                ],
                "properties": {
                  "max": {
                    "type": "integer"
                  },
                  "min": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    },
    "created_at": {
      "$ref": "#/$defs/Date"
    },
    "description": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "updated_at": {
      "$ref": "#/$defs/Date"
    }
  },
  "$defs": {
    "ObjectId": {
      "type": "object",
      "properties": {
        "$oid": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{24}$"
        }
      },
      "required": [
        "$oid"
      ],
      "additionalProperties": false
    },
    "Date": {
      "type": "object",
      "properties": {
        "$date": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "$date"
      ],
      "additionalProperties": false
    }
  }
}